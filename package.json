{
  "name": "nuxt-utc-bucket",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:github-pages": "vite build --mode github-pages",
    "preview": "vite preview",
    "preview:github-pages": "vite preview --mode github-pages",
    "lint": "eslint . --max-warnings 0",
    "lintfix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:host-tz": "node scripts/test-host-timezones.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run check:node && npm run lint && npm run typecheck && npm run test:host-tz && npm run build:github-pages && npm run check:dist"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "dayjs": "^1.11.23",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "volta": {
    "node": "24.22.1"
  }
}
